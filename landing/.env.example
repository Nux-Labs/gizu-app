# Supabase Edge Function URL. Only a confirmed {"status":"registered"} response
# counts as success. See docs/EARLY_ACCESS.md for the handoff contract.
VITE_EARLY_ACCESS_ENDPOINT=
# Optional public/publishable key, only if the function gateway requires apikey.
# Never use a service-role or secret key in a VITE_ variable.
VITE_SUPABASE_PUBLISHABLE_KEY=
