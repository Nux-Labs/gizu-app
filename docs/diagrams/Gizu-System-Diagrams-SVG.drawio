        <mxCell id="gizu-systems-14-38" parent="1" vertex="1" value="Passkeys authorize native operations; PRF protects backups. Derived secp256k1 keys sign exact transactions, ownership proofs, payout intents and orders. Android distribution binds wallet count, weights, cycle and slots.&#xa;Android Earn uses shared Account 2. iOS exposes Ethereum vault primitives without the guided distribution/funding/private-payout journey. Backups emit v3; Android can separately restore synced allocation/history metadata." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#23354B;">
          <mxGeometry x="58" y="1234" width="1769" height="73" as="geometry" />
        </mxCell>
