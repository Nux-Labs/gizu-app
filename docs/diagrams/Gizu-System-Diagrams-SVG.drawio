        <mxCell id="gizu-systems-03-48" parent="1" vertex="1" value="Ready is committed only after the saved backup is reopened and verified. Android generates entropy after verified PRF-enabled registration; iOS first verifies an additional PRF assertion.&#xa;The default Account-1 address receives public Monad USDC. Restore requires the backup and original passkey; Android can separately restore synced allocation/history metadata. Restore alone grants no spending authority." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;spacing=0;strokeColor=none;fillColor=none;fontFamily=Arial;fontSize=14;fontStyle=0;fontColor=#23354B;">
          <mxGeometry x="58" y="1159" width="1769" height="73" as="geometry" />
        </mxCell>
